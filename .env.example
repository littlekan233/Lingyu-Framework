# 这是一个示例 .env 文件。
# groupadmin 依赖 .env 进行相关配置。

### 日志等级
# 默认 INFO。
LOGLEVEL=INFO

### 群聊白名单
# 不在白名单的群聊发指令不会返回任何结果！
GROUP_WHITELIST=[114514233, 123454321]

### WebSocket 反向代理配置
# 监听地址
WSR_HOST="127.0.0.1"
# 监听端口
WSR_PORT=20721

### 权限
# 权限等级
# 使用 int 定义：
# 0 表示该指令可以被普通成员、管理员、群主调用
# 1 表示该指令可以被管理员、群主调用
# 2 表示该指令可以被群主调用
# 大于 2 的权限等级按 2 处理，小于 0 的权限等级按 0 处理
# ----------

## 命令权限
# 撤回命令（/recall 或 /撤回）
PERM_RECALL=1
# 禁言指令（/mute 或 /禁言）以及解禁指令（/unmute 或 /解禁）
PERM_MUTE=1
# 设为精华指令（/essence 或 /设精）
PERM_ESSENCE=0
# 踢人指令（/kick 或 /踢人）
PERM_KICK=2
# 框架帮助指令（/gahelp）
PERM_HELP=0
# 操作记录指令（/audit 或 /操作记录）
PERM_AUDIT=0

## 成员权限等级覆写
# 一个 list，格式为"群号:QQ号:等级"
# 不在列表的成员通过 OneBot 获取到的群聊信息来决定权限等级。
MEMBER_PERM_OVERRIDE='[
    "114514721:987654321:1",
    "334455667:102030405:2",
    "300200100:147258369:0"
]'

### 持久化文件
# 操作记录文件
AUDIT_LOG_FILE=audit_log.json
# 定时任务文件，例如“全体禁言 N 秒后自动解除”
SCHEDULED_TASKS_FILE=scheduled_tasks.json
# 普通成员禁言记录文件，用于防止退群重进绕过禁言
MUTED_MEMBERS_FILE=muted_members.json
